---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const locale = 'en';
const settings = (await getCollection('settings')).find(e => e.data.locale === locale)!;
const s = settings.data;

const posts = (await getCollection('blog'))
  .filter(e => e.data.locale === locale && !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const t = { title: 'Journal', eyebrow: 'SENZA.X Journal', intro: 'Notes on craft, materials, and the work behind the work.' };
---

<Layout locale={locale} title={`${s.brand} — Journal`} description={t.intro}>
  <Nav locale={locale} brand={s.brand} nav={s.nav} />
  <section class="list-page">
    <div class="wrap">
      <div class="eyebrow">{t.eyebrow}</div>
      <h1 class="section-title">{t.title}</h1>
      <p class="body-text">{t.intro}</p>
      <div class="list-grid">
        {posts.map(post => (
          <a class="list-card" href={`/${locale}/blog/${post.id.split('/').pop()}/index.html`}>
            <div class="lc-img"><img src={post.data.cover} alt={post.data.title} loading="lazy"></div>
            <div class="lc-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
            <h3>{post.data.title}</h3>
            <p class="lc-excerpt">{post.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Footer locale={locale} brand={s.brand} brandDesc={s.footer.brandDesc} rights={s.footer.rights} location={s.footer.location} whatsapp={s.contact.whatsapp} email={s.contact.email} wechatId={s.contact.wechatId} wechatQr={s.contact.wechatQr} />
</Layout>
