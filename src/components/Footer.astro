---
interface FooterProps {
  locale: 'en' | 'zh';
  brand: string;
  brandDesc: string;
  rights: string;
  location: string;
  whatsapp: string;
  email: string;
  wechatId: string;
  wechatQr: string;
}

const { locale, brand, brandDesc, rights, location, whatsapp, email, wechatId, wechatQr } = Astro.props;

const homeHref = `/${locale}/index.html`;
const blogHref = `/${locale}/blog/index.html`;
const casesHref = `/${locale}/cases/index.html`;
const anchor = (id: string) => `/${locale}/index.html#${id}`;

const t = {
  en: { navigate: 'Navigate', services: 'Services', client: 'Client Service', connect: 'Connect', about2: 'About SENZA.X',
        bespoke: 'Bespoke', smallBatch: 'Small-batch', designer: 'Designer Editions', oem: 'Brand OEM',
        contactUs: 'Contact us', logistics: 'Logistics', afterSales: 'After-sales', faq: 'FAQ',
        whatsapp: 'WhatsApp', wechat: 'WeChat', emailLabel: 'Email', inquiry: 'Inquiry form',
        history: 'Atelier history', careers: 'Careers', news: 'News', sustainability: 'Sustainability' },
  zh: { navigate: '导航', services: '服务', client: '客户服务', connect: '联系我们', about2: '关于 SENZA.X',
        bespoke: '定制', smallBatch: '小批量', designer: '设计师系列', oem: '品牌代工',
        contactUs: '联系我们', logistics: '物流', afterSales: '售后', faq: '常见问题',
        whatsapp: 'WhatsApp', wechat: '微信', emailLabel: '邮箱', inquiry: '询盘表单',
        history: '工坊历史', careers: '招聘', news: '新闻', sustainability: '可持续' },
}[locale];
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href={homeHref} class="brand">{brand}</a>
        <p>{brandDesc}</p>
      </div>
      <div class="foot-col">
        <h4>{t.navigate}</h4>
        <ul>
          <li><a href={anchor('manifesto')}>{t.navigate}</a></li>
          <li><a href={anchor('models')}>{t.services}</a></li>
          <li><a href={anchor('craft')}>{t.services}</a></li>
          <li><a href={anchor('platform')}>{t.client}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t.services}</h4>
        <ul>
          <li><a href={anchor('contact')}>{t.bespoke}</a></li>
          <li><a href={anchor('contact')}>{t.smallBatch}</a></li>
          <li><a href={anchor('contact')}>{t.designer}</a></li>
          <li><a href={anchor('contact')}>{t.oem}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t.connect}</h4>
        <ul>
          <li><a href={`https://wa.me/${whatsapp}`} target="_blank">{t.whatsapp}</a></li>
          <li><a href="#wechat-modal" onclick="document.getElementById('wechat-modal').style.display='flex';return false;">{t.wechat}</a></li>
          <li><a href={`mailto:${email}`}>{t.emailLabel}</a></li>
          <li><a href={anchor('contact')}>{t.inquiry}</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>{t.about2}</h4>
        <ul>
          <li><a href={blogHref}>{t.news}</a></li>
          <li><a href={casesHref}>{t.history}</a></li>
          <li><a href={anchor('platform')}>{t.sustainability}</a></li>
          <li><a href={anchor('contact')}>{t.careers}</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{rights}</span>
      <span>{location}</span>
    </div>
  </div>
</footer>

<!-- WeChat QR Modal -->
<div id="wechat-modal" onclick="if(event.target===this)this.style.display='none'" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:#fff;padding:32px 32px 24px;max-width:320px;text-align:center;position:relative;">
    <span onclick="document.getElementById('wechat-modal').style.display='none'" style="position:absolute;top:8px;right:14px;font-size:24px;cursor:pointer;color:#0a0a0a;line-height:1;">&times;</span>
    <h3 style="font-family:'Oswald',sans-serif;font-size:18px;letter-spacing:0.05em;color:#0a0a0a;margin:0 0 16px;">WECHAT</h3>
    <div style="width:200px;height:200px;margin:0 auto 16px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border:1px solid #eee;">
      <img src={wechatQr} alt="WeChat QR Code" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none';this.parentElement.innerHTML='<span style=\'font-size:20px;color:#0a0a0a;font-weight:600;letter-spacing:0.05em;\'>'+this.getAttribute('data-id')+'</span>" data-id={wechatId} />
    </div>
    <p style="font-size:13px;color:#666;margin:0 0 4px;">WeChat ID: <strong style="color:#0a0a0a;">{wechatId}</strong></p>
    <p style="font-size:12px;color:#999;margin:0;">Scan QR or add by ID</p>
  </div>
</div>
